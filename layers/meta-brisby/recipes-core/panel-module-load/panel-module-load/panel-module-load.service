[Unit]
Description=Load JD9365DA-H3 panel kernel module before DSI host probes
DefaultDependencies=no
Before=balena-supervisor.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Load by name so the correct module from /lib/modules/.../updates/ is used (avoids "Invalid module format" from stale /usr/lib/panel .ko)
ExecStart=-/sbin/modprobe panel-jadard-jd9365da-h3

[Install]
WantedBy=sysinit.target
